# Конфигурация Docker-развёртывания (скопируйте в .env)
# ARTEX_TAG — локальный тег собранного образа (образ собирается из исходного
# кода этим форком, а не скачивается с Docker Hub). Меняйте только если сами
# публикуете образ под другим тегом.
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (укажите один или оба; можно оставить пустым и настроить в UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
